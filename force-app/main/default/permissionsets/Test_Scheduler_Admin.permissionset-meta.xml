<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Test Scheduler Admin</label>
    <description
  >Grants access to the Apex Test Scheduler admin app: manage schedules, view test class metadata, and enqueue/monitor Apex test runs.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <userPermissions>
        <enabled>true</enabled>
        <name>ViewSetup</name>
    </userPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>ViewRoles</name>
    </userPermissions>

    <classAccesses>
        <apexClass>TestSchedulerController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <tabSettings>
        <tab>Apex_Test_Scheduler</tab>
        <visibility>Visible</visibility>
    </tabSettings>

    <applicationVisibilities>
        <application>Apex_Test_Scheduler</application>
        <visible>true</visible>
    </applicationVisibilities>

    <objectPermissions>
        <object>Test_Schedule__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>true</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Test_Schedule_Class__c</object>
